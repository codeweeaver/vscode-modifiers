{
  "geminicodeassist.agentYoloMode": true,
  "editor.copyWithSyntaxHighlighting": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.emptySelectionClipboard": false,
  "workbench.editor.enablePreview": false,
  "window.newWindowDimensions": "inherit",
  "editor.multiCursorModifier": "ctrlCmd",
  "files.trimTrailingWhitespace": true,
  "diffEditor.renderSideBySide": false,
  "editor.detectIndentation": false,
  "window.nativeFullScreen": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "workbench.editor.showTabs": "none",
  "editor.minimap.enabled": false,
  "editor.lineNumbers": "on",
  "editor.guides.indentation": false,

  // Silence the Noise
  "breadcrumbs.enabled": false,
  "scm.diffDecorations": "none",
  "editor.hover.enabled": "on",
  "editor.matchBrackets": "never",
  "workbench.tips.enabled": false,
  "editor.colorDecorators": false,
  "git.decorations.enabled": false,
  "workbench.startupEditor": "none",
  "editor.lightbulb.enabled": "off",
  "editor.selectionHighlight": false,
  "editor.overviewRulerBorder": false,
  "editor.renderLineHighlight": "none",
  "editor.occurrencesHighlight": "off",
  "problems.decorations.enabled": false,
  "editor.renderControlCharacters": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",

  // Typography - High performance stack
  "editor.fontFamily": "'MesloLGL Nerd Font', 'JetBrains Mono', 'Geist Mono', monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
  "editor.fontSize": 13,
  "editor.lineHeight": 24,
  "editor.fontWeight": "500",
  "editor.cursorBlinking": "solid",
  "editor.padding.top": 16,
  "workbench.iconTheme": "helium-icon-theme",
  "workbench.productIconTheme": "fluent-icons",
  "material-icon-theme.saturation": 0,
  "material-icon-theme.files.color": "#42a5f5",

  // Layout & Explorer
  "explorer.sortOrder": "type",
  "explorer.confirmDelete": false,
  "workbench.tree.indent": 15,
  "workbench.tree.enableStickyScroll": false,
  "workbench.statusBar.visible": false,
  "workbench.layoutControl.enabled": false,
  "window.menuBarVisibility": "compact",
  "window.commandCenter": false,
  "window.titleBarStyle": "custom",

  // Editor chrome
  "editor.showFoldingControls": "never",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "visible",
  "editor.renderWhitespace": "none",
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.list.smoothScrolling": true,
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.suggest.insertMode": "replace",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on",
  },

  // Word Wrap
  "editor.wordWrap": "on",
  "editor.wrappingIndent": "same",
  "editor.wrappingStrategy": "advanced",
  "editor.rulers": [100, 120],

  // APC Customize UI++
  "apc.electron": {
    "titleBarStyle": "hidden",
    "backgroundColor": "#1e1e2e",
  },
  "apc.font.family": "MesloLGL Nerd Font",
  "apc.listRow": {
    "lists": ["explorer-folders-view", "quick-input-list", "results"],
    "height": 30,
  },
  "apc.stylesheet": {
    ".title-actions": "display: none !important",
    ".quick-input-widget.show-file-icons, .editor-widget.find-widget": "box-shadow: none !important",
    ".filematch .monaco-icon-label:before, .custom-list-row.results .monaco-list-row .monaco-icon-label:before": "background-position: 0 bottom !important",
    ".filematch .monaco-count-badge": "padding: 5px 6px 0 6px !important",
    ".sidebar .title-label": "padding: 0 !important",
    ".monaco-workbench .monaco-list:not(.element-focused):focus:before": "outline: none !important",
    ".sidebar": "border: none !important",
    ".monaco-editor .cursors-layer .cursor": "background-image: linear-gradient(135deg, #89dceb 10%, #cba6f7 100%)",
    ".quick-input-list-row div": "display: flex !important; align-items: center !important",
    ".panel .composite.title": "visibility: hidden !important",
    ".title.show-file-icons .label-container .monaco-icon-label.file-icon": "padding-bottom: 6px !important",
    ".sidebar .title-label h2": "line-height: 2.8 !important",
    ".monaco-editor .scroll-decoration": "display: none !important",
    ".monaco-scrollable-element > .shadow.top": "display: none !important",
    ".titlebar-container": "background: #1e1e2e !important",
    ".window-appicon": "display: none !important",
    ".window-title": "display: none !important",
  },
  "workbench.colorCustomizations": {
    "[Catppuccin Mocha]": {
      "editorSuggestWidget.selectedBackground": "#313244",
      "list.activeSelectionBackground": "#313244",
      "list.inactiveSelectionBackground": "#313244",
      "list.focusBackground": "#313244",
      "list.hoverBackground": "#313244",
    },
  },

  // Search & Files
  "search.useIgnoreFiles": false,
  "files.autoSave": "afterDelay",
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/vendor": true,
    "storage": true,
    "**/package-lock.json": true,
  },

  // Formatting & Languages
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
  },
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on",
    },
  },
  "[json]": {
    "editor.wordWrap": "on",
  },
  "[jsonc]": {
    "editor.wordWrap": "on",
  },

  // Unified Terminal Configuration
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontFamily": "'MesloLGL Nerd Font'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.fontLigatures": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.gpuAcceleration": "on",

  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": ["--login", "-i"],
      "icon": "terminal-bash",
    },
    "PowerShell 7": {
      "path": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
      "args": ["-ExecutionPolicy", "Bypass"],
      "icon": "terminal-powershell",
    },
    "Command Prompt": {
      "path": "C:\\Windows\\System32\\cmd.exe",
      "icon": "terminal-cmd",
    },
  },

  // Custom CSS/JS Injector (Ensure these paths exist!)
  "vscode_custom_css.imports": [
    "file:///C:/Users/CODEWEEAVER/vscode-modifiers/style.css",
    "file:///C:/Users/CODEWEEAVER/vscode-modifiers/script.js",
  ],

  // AI & Git Settings
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "geminicodeassist.displayInlineContextHint": false,
  "js/ts.inlayHints.parameterNames.enabled": "literals",

  // External Tool Links
  "liveServer.settings.CustomBrowser": "firefox",
  "terminal.integrated.stickyScroll.enabled": false,
  "editor.stickyScroll.scrollWithEditor": false,

  // "dbcode.connections" intentionally omitted from this snapshot: it held a
  // saved local MongoDB connection (host/username/database name, no password)
  // for an unrelated project. Still present in the real settings.json — just
  // not reproduced here since this repo gets pushed to GitHub.

  "claudeCode.preferredLocation": "panel",
  "animations.Install-Method": "Apc Customize UI++",
  "apc.imports": [
    "file:///c:/Users/CODEWEEAVER/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.7/dist/updateHandler.js",
  ],
  "update.mode": "default",
  "workbench.colorTheme": "Field Lights",
  "workbench.activityBar.location": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "editor.colorDecoratorsActivatedOn": "hover",
  "js/ts.suggest.enabled": false,
  "chat.mcp.gallery.enabled": true,
}
